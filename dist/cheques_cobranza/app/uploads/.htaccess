# ==============================================================================
# PROTECCIÓN ESTRICTA DEL DIRECTORIO DE ARCHIVOS ADJUNTOS / UPLOADS
# ==============================================================================

# Deshabilitar listado de directorios
Options -Indexes

# Desactivar motores de ejecución PHP
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Bloquear cualquier intento de ejecución de scripts
<FilesMatch "(?i)\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi|exe|bat|cmd)$">
    Require all denied
</FilesMatch>
