# ==============================================================================
# SEGURIDAD Y CONFIGURACIÓN DEL SERVIDOR WEB APACHE
# ==============================================================================

# 1. Ocultar listado de directorios y firmas del servidor
Options -Indexes
ServerSignature Off

# 2. Redirección Forzada a HTTPS (Indispensable para validar HSTS en Producción)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Excluir hosts locales e IPs para permitir pruebas en Laragon / entornos de desarrollo
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|.*\.test|.*\.local) [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. Encabezados de Seguridad Globales (OWASP ZAP Hardening)
<IfModule mod_headers.c>
    # Prevenir Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevenir MIME-Type Sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Forzar HTTPS y prevenir ataques de downgrade (HSTS - 1 año + subdominios) cuando HTTPS está activo
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"

    # Control de Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restricción de permisos y APIs del navegador
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=()"

    # Ocultar firmas de lenguaje y servidor
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always unset Server
    Header unset Server

    # Content Security Policy (Balanceada y Compatible con DOM Dinámico)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# 4. Protección de carpetas y directorios sensibles
<IfModule mod_rewrite.c>
    RewriteRule ^(config|docs|cron)(/|$) - [F,L]
</IfModule>

# 5. Impedir lectura directa de archivos sensibles
<FilesMatch "(?i)\.(env|sql|md|log|ini|sh|json|bak|config)$">
    Require all denied
</FilesMatch>

